{
  "name": "gsplayer20",
  "version": "4.0.5",
  "private": true,
  "scripts": {
    "prepare": "node -e \"const fs=require('node:fs'); const {execFileSync}=require('node:child_process'); if (fs.existsSync('scripts/setup-hooks.mjs')) execFileSync(process.execPath, ['scripts/setup-hooks.mjs'], { stdio: 'inherit' });\"",
    "predev": "node scripts/build/generate-codebase-stats.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build/generate-codebase-stats.mjs",
    "build": "next build",
    "start": "next start",
    "readme:update": "node scripts/docs/update-readme.mjs",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "release:plan": "node scripts/release/plan-release.mjs",
    "release:apply": "node scripts/release/apply-version.mjs",
    "db:migrate": "node db/scripts/migrate.js",
    "worker": "node worker.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:compile": "node scripts/test/clean.mjs && tsc -p tsconfig.test.json",
    "test:run:unit": "node scripts/test/run-tests.mjs unit",
    "test:run:integration": "node scripts/test/run-tests.mjs integration",
    "test:coverage": "npm run test:compile && node scripts/test/run-tests.mjs all --coverage",
    "test:e2e": "playwright test",
    "test:unit": "npm run test:compile && npm run test:run:unit",
    "test:integration": "npm run test:compile && npm run test:run:integration",
    "test": "npm run test:compile && npm run test:run:unit && npm run test:run:integration"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.2",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.1",
    "next-auth": "4.24.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-window": "^1.8.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-window": "^1.8.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.26",
    "nanoid": "3.3.18",
    "sharp": "0.35.3"
  }
}
