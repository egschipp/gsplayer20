{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-dist",
    "module": "commonjs",
    "moduleResolution": "node",
    "isolatedModules": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    "src/features/**/*.test.ts",
    "src/features/**/actions/**/*.ts",
    "src/features/**/domain/**/*.ts",
    "src/features/**/data/**/*.ts",
    "src/features/**/types/**/*.ts",
    "src/shared/**/*.ts",
    "lib/**/*.test.ts",
    "lib/crypto.ts",
    "lib/playback/deviceControlPolicy.ts",
    "lib/spotify/scopes.ts",
    "app/components/player/spotifyPlayerTransport.ts",
    "app/components/player/spotifyPlayerTransport.test.ts",
    "app/components/playlist/types.ts",
    "app/components/playlist/trackMatching.ts",
    "app/components/playlist/trackMatching.test.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", ".next", "src/features/**/routes/**/*.ts"]
}
