# Core auth
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_SECRET=
AUTH_URL=https://example.com
NEXTAUTH_URL=
APP_PIN=123456
PIN_CODE=
ADMIN_SPOTIFY_USER_IDS=your-spotify-account-id

# Spotify OAuth
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=https://example.com/api/auth/callback/spotify

# Storage
DB_PATH=/data/gsplayer.sqlite
TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
TOKEN_ENCRYPTION_KEYS=
# Example: TOKEN_ENCRYPTION_KEYS=1:base64-old-key,2:base64-current-key
TOKEN_ENCRYPTION_KEY_VERSION=1
SPOTIFY_FORCE_CONSENT=false
SPOTIFY_IMAGE_MAX_BYTES=5242880
RECENTLY_PLAYED_RETENTION_DAYS=90
JOB_RETENTION_DAYS=30
SPOTIFY_METADATA_TTL_DAYS=1
SPOTIFY_CACHE_COVER_BLOBS=false
OBSERVABILITY_MAX_SERIES=2000

# Optional Redis (rate limits / cache / lock coordination)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional operations tuning
TRUST_PROXY=false
APP_UID=1000
APP_GID=1000
SPOTIFY_FETCH_TIMEOUT_MS=8000
SPOTIFY_FETCH_MAX_ATTEMPTS=3
SPOTIFY_GLOBAL_CONCURRENCY=8
SPOTIFY_APP_REQUESTS_PER_30S=90
SPOTIFY_PER_USER_CONCURRENCY=3
SPOTIFY_PER_USER_BURST=12
SPOTIFY_PER_USER_REFILL_PER_SEC=4
SPOTIFY_QUEUE_MAX_SIZE=500
SPOTIFY_QUEUE_TIMEOUT_MS=12000
SPOTIFY_CIRCUIT_FAILURE_THRESHOLD=6
SPOTIFY_CIRCUIT_OPEN_MS=12000
SPOTIFY_RETRY_AFTER_MAX_MS=120000
SPOTIFY_CACHE_STALE_IF_ERROR_MS=30000
SPOTIFY_UPSTREAM_CIRCUIT_FAILURE_THRESHOLD=4
SPOTIFY_UPSTREAM_CIRCUIT_OPEN_MS=10000
SPOTIFY_UPSTREAM_CIRCUIT_RESET_MS=30000
SPOTIFY_PLAYER_STREAM_PLAYING_POLL_MS=1400
SPOTIFY_PLAYER_STREAM_IDLE_POLL_MS=2200
